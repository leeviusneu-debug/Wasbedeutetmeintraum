# Kopieren nach .env.local und ausfüllen. Diese Werte bleiben auf dem Server
# (kein NEXT_PUBLIC_-Präfix) und werden nie an den Browser ausgeliefert.

# Anbieter für die Traumdeutung: "openai" (Standard) oder "mock"
# ("mock" liefert die Beispieldeutung aus der Demo – praktisch für die Entwicklung).
AI_PROVIDER=openai

# OpenAI – https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: Modell (Standard: gpt-5.4-mini)
OPENAI_MODEL=
# Optional: Denkaufwand für Reasoning-Modelle: minimal | low | medium | high
OPENAI_REASONING_EFFORT=low

# Optional: maximale Deutungen pro IP-Adresse in 10 Minuten (Standard: 6)
ANALYSIS_RATE_LIMIT=
