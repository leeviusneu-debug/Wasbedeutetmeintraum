# Kopieren nach .env.local und ausfüllen. Diese Werte bleiben auf dem Server
# (kein NEXT_PUBLIC_-Präfix) und werden nie an den Browser ausgeliefert.

# Öffentliche Adresse der Website (für Links in E-Mails), z. B. https://example.de
APP_URL=

# Geheimer Schlüssel zum Verschlüsseln der vollständigen Deutung bis zum
# E-Mail-Versand. In Produktion Pflicht. Erzeugen z. B. mit: openssl rand -hex 32
APP_SECRET=

# --- KI ------------------------------------------------------------------
# Anbieter für die Traumdeutung: "openai" (Standard) oder "mock"
# ("mock" liefert eine feste Beispieldeutung – praktisch für die Entwicklung).
AI_PROVIDER=openai

# OpenAI – https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: Modell (Standard: gpt-5.4-mini)
OPENAI_MODEL=
# Optional: Denkaufwand für Reasoning-Modelle: minimal | low | medium | high
OPENAI_REASONING_EFFORT=low

# --- E-Mail --------------------------------------------------------------
# Versanddienst: "resend" oder "outbox" (nur Entwicklung: speichert E-Mails
# als Dateien in .outbox/ statt sie zu verschicken). In Produktion Pflicht.
EMAIL_PROVIDER=
# Resend – https://resend.com/api-keys (Absender-Domain dort verifizieren)
RESEND_API_KEY=
# Absender, z. B.: Was bedeutet mein Traum? <deutung@example.de>
EMAIL_FROM=
# Optional: Antwortadresse
EMAIL_REPLY_TO=

# --- Limits (optional) ---------------------------------------------------
# Deutungen pro IP-Adresse in 10 Minuten (Standard: 6)
ANALYSIS_RATE_LIMIT=
# E-Mail-Anfragen pro IP-Adresse in 10 Minuten (Standard: 5)
DELIVERY_RATE_LIMIT=
# Zusendungen pro E-Mail-Adresse und Tag (Standard: 3)
DELIVERY_LIMIT_PER_EMAIL=
